{
  "name": "magguuui",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.17.0"
  },
  "description": "MagguuUI — World of Warcraft UI Configuration Manager",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "build:clean": "node scripts/clean-build-artifacts.mjs",
    "lint": "eslint . && node scripts/check-uselect-empty-value.mjs",
    "lint:fix": "eslint . --fix",
    "lint:uselect": "node scripts/check-uselect-empty-value.mjs",
    "typecheck": "tsc --noEmit --pretty false",
    "preview": "nuxt preview",
    "verify:smoke": "node scripts/verify-build.mjs",
    "verify": "npm run build:clean && npm run postinstall && npm run build && npm run verify:smoke",
    "audit:prod": "node scripts/audit-prod.mjs",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx server/database/seed.ts",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:install": "playwright install chromium"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@iconify-json/heroicons": "^1.2.0",
    "@iconify-json/simple-icons": "^1.2.93",
    "@nuxt/image": "^2.1.0",
    "@nuxt/ui": "^4.11.3",
    "@resvg/resvg-js": "^2.6.2",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.2",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-underline": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/vue-3": "^3.31.4",
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "echarts": "^6.1.0",
    "h3": "^1.13.0",
    "jsonwebtoken": "^9.0.3",
    "marked": "^18.0.14",
    "nuxt": "^4.4.8",
    "nuxt-og-image": "^6.5.2",
    "reflect-metadata": "^0.2.2",
    "sanitize-html": "^2.17.7",
    "satori": "^0.34.1",
    "tailwindcss": "^4.3.2",
    "vue-echarts": "^8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.63.0",
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/sanitize-html": "^2.16.1",
    "drizzle-kit": "^0.31.0",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.2"
  },
  "overrides": {
    "brace-expansion@2.1.4": "2.1.7",
    "brace-expansion@5.0.9": "5.0.12",
    "devalue": "5.9.4",
    "esbuild": "0.28.1",
    "fflate": "0.8.3",
    "svgo": "4.1.0",
    "undici": "8.11.2",
    "@vue/server-renderer": "3.5.43",
    "seroval": "1.6.8",
    "shell-quote": "1.12.0",
    "source-map-js": "1.2.2",
    "vue": "3.5.43"
  }
}
