#!/bin/sh
# Pre-push gate: lint, typecheck, unit tests, actionlint. Enable with:
#   npm run hooks:install   (= git config core.hooksPath .githooks)
# Bypass in emergencies: git push --no-verify
set -eu
cd "$(git rev-parse --show-toplevel)"
echo "[pre-push] lint"; npm run --silent lint
echo "[pre-push] typecheck"; npm run --silent typecheck
echo "[pre-push] unit tests"; npm run --silent test:unit
if command -v actionlint >/dev/null 2>&1; then
  echo "[pre-push] actionlint"; actionlint .github/workflows/*.yml
else
  echo "[pre-push] WARNING: actionlint not installed, skipping workflow lint" >&2
fi
echo "[pre-push] OK"
