NUXT_JWT_SECRET=
NUXT_ADMIN_PASSWORD=

# Optional auth/session settings
NUXT_AUTH_COOKIE_NAME=
NUXT_FORCE_PASSWORD_RESET=

# Canonical AddOn sync API (required when workflow sync is enabled)
API_BEARER_TOKEN=

# Optional GitHub sync/webhook integration
NUXT_GITHUB_TOKEN=
NUXT_GITHUB_REPO=Derpsen/MagguuUI
NUXT_GITHUB_WEBHOOK_SECRET=

# Optional WebAuthn/passkeys
NUXT_WEBAUTHN_RP_ID=
NUXT_WEBAUTHN_ORIGIN=

# Optional content seed behavior
NUXT_SYNC_SEEDED_CONTENT=

# OG image request signing for dynamic nuxt-og-image URLs
# Generate outside the repo with: npx nuxt-og-image generate-secret
NUXT_OG_IMAGE_SECRET=

# Optional Cloudflare edge cache purge. Public pages + /api/v1/catalog-summary
# send CDN-Cache-Control (120s, stale-while-revalidate 600s). With both set,
# admin/sync/webhook writes purge the zone cache; empty = logged no-op.
# Token scope: Zone -> Cache Purge -> Purge (this zone only).
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# Build info shown in the admin (set by docker.yml build-args; fallback "dev")
GIT_SHA=
BUILD_TIME=

# Optional Meta snapshot (EU Mythic+). Server-only; never expose to the browser.
# Default off. The job also stays off when the client id/secret are empty.
# Recognised flag values: on|true|1|yes and off|false|0|no.
NUXT_BLIZZARD_CLIENT_ID=
NUXT_BLIZZARD_CLIENT_SECRET=
NUXT_BLIZZARD_REGION=eu
NUXT_META_NIGHTLY=
NUXT_META_KUMA_PUSH_URL=
NUXT_META_SAMPLE_PER_SPEC=
NUXT_META_MAX_ATTEMPTS_PER_SPEC=
NUXT_META_MAX_CONCURRENT_SPECS=
# Optional Meta nightly heap-guard cap in MB (default: V8 heap_size_limit).
NUXT_META_HEAP_LIMIT_MB=
# Master ads switch (default off). Reserved AdSlot markup only when on/true/1/yes.
# Read at process start (not baked into the image).
NUXT_ADS=
